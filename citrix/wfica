#!/bin/bash
# Launch wrapper: NVIDIA VAAPI/NVDEC, clip bridge, packaged wfclient.ini.
ICAROOT=/opt/Citrix/ICAClient
export ICAROOT
export LD_LIBRARY_PATH="${ICAROOT}/lib:${ICAROOT}/Webkit2gtk4.0/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export GTK_PATH="${ICAROOT}/gtk${GTK_PATH:+:${GTK_PATH}}"
# nvidia-vaapi-driver → NVDEC. Citrix only talks VAAPI, not NVDEC directly.
export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-nvidia}"
export NVD_BACKEND="${NVD_BACKEND:-direct}"

CLIENTFILE="${ICAROOT}/config/wfclient.ini"
PROTOCOLFILE="${ICAROOT}/config/module.ini"
REALWFICA="${ICAROOT}/wfica.real"

if [ ! -x "$REALWFICA" ]; then
  echo "wfica: missing $REALWFICA" >&2
  exit 127
fi

# ~/.ICAClient/All_Regions.ini overrides the packaged one. Empty
# KeyboardLayout=/UseEUKS=* lets StoreFront force US QWERTY onto nested
# MSTSC / Winlogon. Re-pin AZERTY + EUKS on every launch.
if [ -f "${HOME:-}/.ICAClient/All_Regions.ini" ]; then
  python3 - "${HOME}/.ICAClient/All_Regions.ini" <<'PY' 2>/dev/null || true
import sys
from pathlib import Path
path = Path(sys.argv[1])
section = "[Virtual Channels\\Keyboard]"
updates = {
    "KeyboardLayout": "French",
    "KeyboardEventMode": "Scancode",
    "KeyboardSyncMode": "Once",
    "KeyboardMappingFile": "automatic.kbd",
    "KeyboardSendLocale": "True",
    "UseEUKS": "2",
    "UseEUKSforASCII": "True",
    "ScancodeEnabled": "True",
}
raw = path.read_text()
newline = "\r\n" if "\r\n" in raw else "\n"
lines = raw.splitlines()
try:
    idx = next(i for i, line in enumerate(lines) if line.strip() == section)
except StopIteration:
    sys.exit(0)
end = idx + 1
while end < len(lines):
    s = lines[end].strip()
    if s.startswith("[") and s.endswith("]"):
        break
    end += 1
done = set()
for i in range(idx + 1, end):
    line = lines[i]
    if not line or line.lstrip().startswith(";") or "=" not in line:
        continue
    key = line.split("=", 1)[0].strip()
    if key in updates:
        lines[i] = f"{key}={updates[key]}"
        done.add(key)
ins = idx + 1
for key, value in updates.items():
    if key not in done:
        lines.insert(ins, f"{key}={value}")
        ins += 1
path.write_text(newline.join(lines) + newline)
PY
fi

# Clip bridge is a user systemd service. Keep a fallback start if it is not
# running yet; do not kill a systemd-managed instance on every wfica launch.
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -x "$ICAROOT/util/clip-bridge-rs" ]; then
    if ! systemctl --user is-active --quiet citrix-clip-bridge.service 2>/dev/null; then
        setsid env -u GTK_PATH -u GTK_EXE_PREFIX -u GTK_DATA_PREFIX -u LD_LIBRARY_PATH \
          DISPLAY="${DISPLAY:-:0}" \
          WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
          XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
          HOME="${HOME:-}" PATH="/usr/bin:/bin" \
          "$ICAROOT/util/clip-bridge-rs" >/dev/null 2>&1 &
    fi
fi

filearg=
if [ "$#" -eq 1 ] && [ -f "$1" ]; then
  case "$1" in
    *.ica|*.ICA) filearg=$(readlink -f "$1") ;;
  esac
fi

if [ -n "$filearg" ]; then
  set -- -icaroot "$ICAROOT" -protocolfile "$PROTOCOLFILE" -clientfile "$CLIENTFILE" \
    -file "$filearg"
else
  set -- -icaroot "$ICAROOT" -protocolfile "$PROTOCOLFILE" -clientfile "$CLIENTFILE" \
    "$@"
fi

exec -a "$ICAROOT/wfica" "$REALWFICA" "$@"
