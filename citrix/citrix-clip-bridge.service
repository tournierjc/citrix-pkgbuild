[Unit]
Description=Citrix Wayland/X11 clipboard bridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/Citrix/ICAClient/util/clip-bridge-rs --foreground
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
