def log(msg: str) -> None:
    try:
        syslog.syslog(syslog.LOG_INFO | syslog.LOG_USER, msg)
    except Exception:
        pass


def daemonize() -> None:
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    if os.fork() > 0:
        os._exit(0)
    os.chdir("/")
    fd = os.open(os.devnull, os.O_RDWR)
    os.dup2(fd, 0)
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    if fd > 2:
        os.close(fd)


def pixbuf_to_dib(pb) -> bytes:
    """32bpp BI_RGB in Citrix _ISL_DIB layout (pixels at 0x428)."""
    from gi.repository import GdkPixbuf

    if pb.get_has_alpha() or pb.get_n_channels() != 3:
        w, h = pb.get_width(), pb.get_height()
        bg = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h)
        bg.fill(0xFFFFFFFF)
        pb.composite(
            bg, 0, 0, w, h, 0, 0, 1.0, 1.0, GdkPixbuf.InterpType.NEAREST, 255
        )
        pb = bg
    w, h = pb.get_width(), pb.get_height()
    nch = pb.get_n_channels()
    rs = pb.get_rowstride()
    pixels = bytes(pb.get_pixels())
    stride = w * 4
    out = bytearray(ISL_PIXELS + stride * h)
    struct.pack_into(
        "<IiiHHIIiiII",
        out,
        0,
        40,
        w,
        h,
        1,
        32,
        0,
        stride * h,
        0,
        0,
        0,
        0,
    )
    for y in range(h):
        src = (h - 1 - y) * rs
        dst = ISL_PIXELS + y * stride
        sx = src
        dx = dst
        for _x in range(w):
            out[dx] = pixels[sx + 2]
            out[dx + 1] = pixels[sx + 1]
            out[dx + 2] = pixels[sx]
            sx += nch
            dx += 4
    return bytes(out)


def as_cf_dib(isl: bytes) -> bytes:
    if len(isl) < ISL_PIXELS:
        return isl
    return isl[:40] + isl[ISL_PIXELS:]


def isl_dib_to_pixbuf(data: bytes):
    from gi.repository import GdkPixbuf

    if len(data) < 40:
        return None
    bi_size, w, h, _planes, bpp, comp, _sizeimg, _x, _y, clrused, _cimp = (
        struct.unpack_from("<IiiHHIIiiII", data, 0)
    )
    if bi_size < 40 or w <= 0 or h == 0 or bpp not in (24, 32):
        return None
    h_abs = abs(h)
    stride = ((w * bpp + 31) // 32) * 4
    pix_off = ISL_PIXELS
    if len(data) < pix_off + stride * h_abs:
        pix_off = bi_size + (clrused * 4 if clrused else 0)
        if comp == 3:
            pix_off += 12
    if pix_off + stride * h_abs > len(data) or stride <= 0:
        return None
    pb = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h_abs)
    dest = bytearray(pb.get_pixels())
    drs = pb.get_rowstride()
    top_down = h < 0
    src_bpp = bpp // 8
    for y in range(h_abs):
        src_y = y if top_down else (h_abs - 1 - y)
        sbase = pix_off + src_y * stride
        dbase = y * drs
        sx = sbase
        dx = dbase
        for _x in range(w):
            dest[dx] = data[sx + 2]
            dest[dx + 1] = data[sx + 1]
            dest[dx + 2] = data[sx]
            sx += src_bpp
            dx += 3
    packed = GdkPixbuf.Pixbuf.new_from_data(
        bytes(dest),
        GdkPixbuf.Colorspace.RGB,
        False,
        8,
        w,
        h_abs,
        drs,
    )
    return packed.copy()


def wfica_wm_class(text: str) -> bool:
    return "Wfica" in text or "wfica" in text


def x_atom(name: str) -> int:
    if x11_dpy is None:
        return 0
    if name == "PRIMARY":
        return XA_PRIMARY
    return int(libX11.XInternAtom(x11_dpy, name.encode(), 0))


def selection_owner_xid(name: str) -> int:
    if x11_dpy is None:
        return 0
    return int(libX11.XGetSelectionOwner(x11_dpy, x_atom(name)))


def x_parent(xid: int) -> int:
    if x11_dpy is None or xid == 0:
        return 0
    root = ctypes.c_ulong()
    parent = ctypes.c_ulong()
    children = ctypes.c_void_p()
    nch = ctypes.c_uint()
    if not libX11.XQueryTree(
        x11_dpy,
        xid,
        ctypes.byref(root),
        ctypes.byref(parent),
        ctypes.byref(children),
        ctypes.byref(nch),
    ):
        return 0
    if children:
        libX11.XFree(children)
    return int(parent.value)


def x_class_text(xid: int) -> str:
    if x11_dpy is None or xid == 0:
        return ""
    hint = _XClassHint()
    if not libX11.XGetClassHint(x11_dpy, xid, ctypes.byref(hint)):
        return ""
    parts = []
    for ptr in (hint.res_name, hint.res_class):
        if not ptr:
            continue
        raw = ctypes.cast(ptr, ctypes.c_char_p).value
        if raw:
            parts.append(raw.decode("utf-8", "replace"))
        libX11.XFree(ptr)
    return " ".join(parts)


def window_is_wfica(xid: int) -> bool:
    """wfica's CLIPBOARD owner is an unmapped child without WM_CLASS."""
    cur = xid
    seen = set()
    for _ in range(10):
        if cur == 0 or cur in seen:
            return False
        seen.add(cur)
        if wfica_wm_class(x_class_text(cur)):
            return True
        parent = x_parent(cur)
        if parent == cur:
            return False
        cur = parent
    return False


def holder_xid() -> int:
    from gi.repository import GdkX11

    if holder is None:
        return 0
    win = holder.get_window()
    if win is None:
        return 0
    try:
        return int(GdkX11.X11Window.get_xid(win))
    except Exception:
        return 0


def wfica_is_focused() -> bool:
    try:
        r = subprocess.run(
            ["xprop", "-root", "_NET_ACTIVE_WINDOW"],
            capture_output=True,
            text=True,
            timeout=0.4,
        )
    except Exception:
        return False
    xid = None
    for part in r.stdout.replace(",", " ").split():
        if part.startswith("0x"):
            xid = part
    if not xid:
        return False
    try:
        return window_is_wfica(int(xid, 16))
    except ValueError:
        return False


def owner_is_wfica(selection) -> bool:
    name = _atom_name(selection) if selection is not None else "CLIPBOARD"
    if name not in ("CLIPBOARD", "PRIMARY"):
        name = "CLIPBOARD"
    xid = selection_owner_xid(name)
    if xid == 0 or xid == holder_xid():
        return False
    return window_is_wfica(xid)


def we_own(selection) -> bool:
    name = _atom_name(selection) if selection is not None else "CLIPBOARD"
    if name not in ("CLIPBOARD", "PRIMARY"):
        name = "CLIPBOARD"
    hid = holder_xid()
    return hid != 0 and selection_owner_xid(name) == hid


def x11_now() -> int:
    from gi.repository import GdkX11

    if holder is None:
        return 0
    win = holder.get_window()
    if win is None:
        return 0
    try:
        return int(GdkX11.x11_get_server_time(win))
    except Exception:
        return 0


def offer_selections(both: bool = True) -> None:
    from gi.repository import Gtk, Gdk

    if holder is None or not dib_bytes:
        return
    if owner_is_wfica(Gdk.SELECTION_CLIPBOARD) and not we_own(
        Gdk.SELECTION_CLIPBOARD
    ):
        return
    t = x11_now() or Gdk.CURRENT_TIME
    Gtk.selection_owner_set(holder, Gdk.SELECTION_PRIMARY, t)
    if both:
        if wfica_is_focused() and not we_own(Gdk.SELECTION_CLIPBOARD):
            if owner_is_wfica(Gdk.SELECTION_CLIPBOARD):
                return
        Gtk.selection_owner_set(holder, Gdk.SELECTION_CLIPBOARD, t)


def pixbuf_to_png(pb) -> bytes:
    ok, buf = pb.save_to_bufferv("png", [], [])
    if not ok or not buf:
        return b""
    return bytes(buf)


def wl_copy_png(png: bytes) -> None:
    if not png:
        return
    try:
        subprocess.run(
            ["wl-copy", "--type", "image/png"],
            input=png,
            check=False,
            timeout=8,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as exc:
        log(f"wl-copy failed: {exc}")


def ingest_png() -> None:
    global dib_bytes, pixbuf, last_hash, reassert_left, logged_gets
    try:
        png = open(PNG_PATH, "rb").read()
    except OSError:
        return
    if not png:
        return
    digest = hashlib.sha256(png).hexdigest()
    if digest == last_hash:
        return
    try:
        from gi.repository import GdkPixbuf

        loader = GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(png)
        loader.close()
        pb = loader.get_pixbuf()
        if pb is None:
            return
        dib = pixbuf_to_dib(pb)
    except Exception as exc:
        log(f"png to DIB failed: {exc}")
        return
    if len(dib) < 40:
        return
    dib_bytes = dib
    pixbuf = pb
    last_hash = digest
    logged_gets = set()
    offer_selections(True)
    reassert_left = 6
    log(f"offered DIB {pb.get_width()}x{pb.get_height()} ({len(dib_bytes)} bytes)")


def publish_session_image(pb) -> None:
    """Citrix → Wayland. Do not steal X11 from wfica."""
    global pixbuf, last_hash, dib_bytes, reassert_left
    png = pixbuf_to_png(pb)
    if not png:
        return
    digest = hashlib.sha256(png).hexdigest()
    if digest == last_hash:
        return
    last_hash = digest
    pixbuf = pb
    dib_bytes = pixbuf_to_dib(pb)
    reassert_left = 0
    wl_copy_png(png)
    log(f"exported session image {pb.get_width()}x{pb.get_height()} to Wayland")


def _requestor_xid(requestor) -> int:
    from gi.repository import GdkX11

    if requestor is None:
        return 0
    try:
        return int(GdkX11.X11Window.get_xid(requestor))
    except Exception:
        try:
            return int(requestor)
        except Exception:
            return 0


def _atom_x(atom) -> int:
    from gi.repository import GdkX11

    if atom is None:
        return 0
    try:
        return int(GdkX11.x11_atom_to_xatom(atom))
    except Exception:
        return 0


def _atom_name(atom) -> str:
    try:
        return atom.name()
    except Exception:
        return ""


def send_dib_property(event, payload: bytes) -> bool:
    """Put the whole DIB on the requestor in one BIG-REQUESTS ChangeProperty."""
    if x11_dpy is None or not payload:
        return False
    req = _requestor_xid(event.requestor)
    target = _atom_x(event.target)
    prop = _atom_x(event.property)
    if prop == 0:
        prop = target
    if req == 0 or target == 0:
        return False
    buf = ctypes.create_string_buffer(payload, len(payload))
    libX11.XChangeProperty(
        x11_dpy,
        req,
        prop,
        target,
        8,
        PropModeReplace,
        buf,
        len(payload),
    )
    libX11.XFlush(x11_dpy)
    from gi.repository import Gdk

    Gdk.selection_send_notify(
        event.requestor,
        event.selection,
        event.target,
        event.property if _atom_x(event.property) else event.target,
        event.time,
    )
    return True


def on_selection_request(_widget, event) -> bool:
    global logged_gets
    name = _atom_name(event.target)
    if name not in logged_gets:
        logged_gets.add(name)
        log(f"selection-request {name}")
    if name == "_ISL_DIB" and dib_bytes:
        return send_dib_property(event, dib_bytes)
    if name == "DIB" and dib_bytes:
        return send_dib_property(event, as_cf_dib(dib_bytes))
    if name == "_ISL_RGBQUAD":
        return send_dib_property(event, bytes(ISL_RGBQUAD))
    if name == "image/bmp" and dib_bytes:
        cf = as_cf_dib(dib_bytes)
        bmp = b"BM" + struct.pack("<IHHI", 14 + len(cf), 0, 0, 54) + cf
        return send_dib_property(event, bmp)
    return False


def on_selection_get(_widget, selection_data, info, _time) -> None:
    global logged_gets
    target = selection_data.get_target()
    try:
        name = target.name()
    except Exception:
        name = "?"
    if name not in logged_gets:
        logged_gets.add(name)
        log(f"selection-get {name} info={info}")
    if info == 3 and pixbuf is not None:
        selection_data.set_pixbuf(pixbuf)


def on_selection_clear(_widget, event) -> bool:
    global reassert_left, pulled_owner_xid, wfica_pull_tries
    name = _atom_name(event.selection)
    if name == "CLIPBOARD":
        reassert_left = 0
        pulled_owner_xid = 0
        wfica_pull_tries = 0
        from gi.repository import GLib

        GLib.timeout_add(200, request_wfica_image)
    return False


def on_reassert() -> bool:
    global reassert_left
    if reassert_left <= 0 or not dib_bytes:
        return True
    from gi.repository import Gdk

    if owner_is_wfica(Gdk.SELECTION_CLIPBOARD):
        reassert_left = 0
        return True
    reassert_left -= 1
    if wfica_is_focused():
        return True
    if we_own(Gdk.SELECTION_CLIPBOARD):
        return True
    offer_selections(True)
    return True


def request_wfica_image() -> bool:
    global import_pending
    from gi.repository import Gtk, Gdk, GLib

    if import_pending or holder is None:
        return False
    if we_own(Gdk.SELECTION_CLIPBOARD):
        return False
    xid = selection_owner_xid("CLIPBOARD")
    if not window_is_wfica(xid):
        xid = selection_owner_xid("PRIMARY")
        if not window_is_wfica(xid):
            return False
    import_pending = True
    log(f"pull image from wfica owner 0x{xid:x}")

    def finish_pixbuf(pb, src: str) -> None:
        global import_pending, pulled_owner_xid, wfica_pull_tries
        import_pending = False
        if pb is None:
            log(f"pull {src} empty")
            return
        pulled_owner_xid = xid
        wfica_pull_tries = 0
        log(f"pull {src} {pb.get_width()}x{pb.get_height()}")
        publish_session_image(pb)

    def got_image(_clip, pb) -> None:
        finish_pixbuf(pb, "PIXMAP")

    def got_plain_dib(_clip, sel_data) -> None:
        raw = bytes(sel_data.get_data() or b"")
        log(f"pull DIB {len(raw)} bytes")
        pb = isl_dib_to_pixbuf(raw) if len(raw) >= 40 else None
        if pb is not None:
            finish_pixbuf(pb, "DIB")
            return
        clip.request_image(got_image)

    def got_isl(_clip, sel_data) -> None:
        raw = bytes(sel_data.get_data() or b"")
        log(f"pull _ISL_DIB {len(raw)} bytes")
        pb = isl_dib_to_pixbuf(raw) if len(raw) >= 40 else None
        if pb is not None:
            finish_pixbuf(pb, "_ISL_DIB")
            return
        if atom_dib is not None:
            clip.request_contents(atom_dib, got_plain_dib)
            return
        clip.request_image(got_image)

    def clear_pending() -> bool:
        global import_pending
        import_pending = False
        return False

    GLib.timeout_add(5000, clear_pending)
    clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    if atom_isl is None:
        import_pending = False
        return False
    clip.request_contents(atom_isl, got_isl)
    return False


def poll_wfica_export() -> bool:
    global pulled_owner_xid, wfica_pull_tries
    from gi.repository import Gdk

    if we_own(Gdk.SELECTION_CLIPBOARD):
        pulled_owner_xid = holder_xid()
        wfica_pull_tries = 0
        return True
    xid = selection_owner_xid("CLIPBOARD")
    if not window_is_wfica(xid):
        xid = selection_owner_xid("PRIMARY")
    if not window_is_wfica(xid):
        wfica_pull_tries = 0
        return True
    if xid == pulled_owner_xid:
        return True
    if import_pending:
        return True
    if wfica_pull_tries >= 12:
        return True
    wfica_pull_tries += 1
    request_wfica_image()
    return True


def setup_xfixes(GLib) -> None:
    """Notice wfica re-asserting CLIPBOARD for a new session copy."""
    global xa_clipboard
    try:
        xfixes = ctypes.CDLL("libXfixes.so.3")
    except OSError:
        log("libXfixes missing; session copies may need a focus change")
        return
    xfixes.XFixesQueryExtension.restype = ctypes.c_int
    xfixes.XFixesQueryExtension.argtypes = [
        ctypes.c_void_p,
        ctypes.POINTER(ctypes.c_int),
        ctypes.POINTER(ctypes.c_int),
    ]
    evbase = ctypes.c_int()
    errbase = ctypes.c_int()
    if not xfixes.XFixesQueryExtension(
        x11_dpy, ctypes.byref(evbase), ctypes.byref(errbase)
    ):
        return
    xfixes.XFixesSelectSelectionInput.argtypes = [
        ctypes.c_void_p,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.c_ulong,
    ]
    libX11.XDefaultRootWindow.restype = ctypes.c_ulong
    libX11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    libX11.XCreateSimpleWindow.restype = ctypes.c_ulong
    libX11.XCreateSimpleWindow.argtypes = [
        ctypes.c_void_p,
        ctypes.c_ulong,
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_uint,
        ctypes.c_uint,
        ctypes.c_uint,
        ctypes.c_ulong,
        ctypes.c_ulong,
    ]
    libX11.XConnectionNumber.restype = ctypes.c_int
    libX11.XConnectionNumber.argtypes = [ctypes.c_void_p]
    libX11.XPending.restype = ctypes.c_int
    libX11.XPending.argtypes = [ctypes.c_void_p]
    libX11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    root = libX11.XDefaultRootWindow(x11_dpy)
    win = libX11.XCreateSimpleWindow(x11_dpy, root, 0, 0, 1, 1, 0, 0, 0)
    xa_clipboard = x_atom("CLIPBOARD")
    mask = 1 | 2 | 4  # owner / destroy / client-close
    xfixes.XFixesSelectSelectionInput(x11_dpy, win, xa_clipboard, mask)
    xfixes.XFixesSelectSelectionInput(x11_dpy, win, XA_PRIMARY, mask)
    libX11.XFlush(x11_dpy)
    notify_type = int(evbase.value)
    xfd = libX11.XConnectionNumber(x11_dpy)
    xev = ctypes.create_string_buffer(256)

    def on_x11(_fd, _cond) -> bool:
        global pulled_owner_xid, wfica_pull_tries
        while libX11.XPending(x11_dpy):
            libX11.XNextEvent(x11_dpy, xev)
            ev_type = struct.unpack_from("i", xev)[0]
            if ev_type != notify_type:
                continue
            pulled_owner_xid = 0
            wfica_pull_tries = 0
            request_wfica_image()
        return True

    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, xfd, GLib.IOCondition.IN, on_x11)
    log(f"XFixes selection notify on fd {xfd}")


def notify_daemon() -> None:
    try:
        fd = os.open(NOTIFY_PATH, os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, b"x")
        finally:
            os.close(fd)
    except OSError as exc:
        log(f"ingest notify failed: {exc}")


def ingest_mode() -> int:
    png = sys.stdin.buffer.read()
    if not png:
        return 0
    try:
        with open(PNG_PATH, "wb") as fh:
            fh.write(png)
            fh.flush()
            os.fsync(fh.fileno())
        notify_daemon()
    except Exception as exc:
        log(f"ingest failed: {exc}")
    return 0


def open_notify_fifo() -> int:
    try:
        st = os.lstat(NOTIFY_PATH)
        if not stat.S_ISFIFO(st.st_mode):
            os.unlink(NOTIFY_PATH)
            st = None
    except FileNotFoundError:
        st = None
    if st is None:
        os.mkfifo(NOTIFY_PATH, 0o600)
    return os.open(NOTIFY_PATH, os.O_RDWR | os.O_NONBLOCK)


def daemon_mode(foreground: bool = False) -> int:
    global holder, x11_dpy
    global atom_dib, atom_isl, atom_bmp, atom_pix, atom_rgbquad

    if not os.environ.get("WAYLAND_DISPLAY"):
        return 1 if foreground else 0
    if not os.environ.get("DISPLAY"):
        return 1 if foreground else 0

    if not foreground:
        daemonize()

    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    x11_dpy = libX11.XOpenDisplay(None)
    if not x11_dpy:
        return 0

    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk, GLib

    syslog.openlog("citrix-clip-bridge")
    ext = libX11.XExtendedMaxRequestSize(x11_dpy)
    log(f"X11 BIG-REQUESTS max {int(ext) * 4} bytes")

    holder = Gtk.Invisible()
    holder.show()

    atom_dib = Gdk.Atom.intern("DIB", False)
    atom_isl = Gdk.Atom.intern("_ISL_DIB", False)
    atom_bmp = Gdk.Atom.intern("image/bmp", False)
    atom_pix = Gdk.Atom.intern("PIXMAP", False)
    atom_rgbquad = Gdk.Atom.intern("_ISL_RGBQUAD", False)
    for sel in (Gdk.SELECTION_CLIPBOARD, Gdk.SELECTION_PRIMARY):
        Gtk.selection_clear_targets(holder, sel)
        Gtk.selection_add_target(holder, sel, atom_dib, 1)
        Gtk.selection_add_target(holder, sel, atom_isl, 1)
        Gtk.selection_add_target(holder, sel, atom_rgbquad, 4)
        Gtk.selection_add_target(holder, sel, atom_bmp, 2)
        Gtk.selection_add_target(holder, sel, atom_pix, 3)

    holder.connect("selection-request-event", on_selection_request)
    holder.connect("selection-get", on_selection_get)
    holder.connect("selection-clear-event", on_selection_clear)
    setup_xfixes(GLib)

    notify_fd = open_notify_fifo()

    def on_notify(fd, _condition) -> bool:
        try:
            os.read(fd, 4096)
        except OSError:
            pass
        ingest_png()
        return True

    GLib.unix_fd_add_full(
        GLib.PRIORITY_DEFAULT, notify_fd, GLib.IOCondition.IN, on_notify
    )
    GLib.timeout_add(250, on_reassert)
    GLib.timeout_add(400, poll_wfica_export)

    os.ftruncate(lock_fd, 0)
    os.lseek(lock_fd, 0, os.SEEK_SET)
    os.write(lock_fd, f"{os.getpid()}\n".encode())
    os.fsync(lock_fd)
    with open(PID_PATH, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))

    watch = subprocess.Popen(
        [
            "wl-paste",
            "--type",
            "image/png",
            "--watch",
            sys.executable,
            os.path.abspath(sys.argv[0]),
            "--ingest",
        ],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    def on_exit(_signum=None, _frame=None) -> None:
        try:
            watch.terminate()
        except Exception:
            pass
        try:
            os.unlink(PID_PATH)
        except OSError:
            pass
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, on_exit)
    signal.signal(signal.SIGINT, on_exit)
    log("watching Wayland image/png for X11 ISL_DIB (pixels at 0x428)")
    Gtk.main()
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args in (["--ingest"], ["--convert"]):
        return ingest_mode()
    return daemon_mode(foreground="--foreground" in args)


if __name__ == "__main__":
    sys.exit(main())
