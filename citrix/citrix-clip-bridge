#!/bin/sh
# Copy Wayland image/png (Spectacle, etc.) onto the X11 CLIPBOARD as DIB.
# wfica only imports XA_DIB/XA_PIXMAP from X11, so Wayland screenshots never
# reach Windows (or nested MSTSC) without this conversion.
set -eu

have() { command -v "$1" >/dev/null 2>&1; }

png_to_dib() {
  if have magick; then
    magick png:- bmp:-
  elif have convert; then
    convert png:- bmp:-
  elif have ffmpeg; then
    ffmpeg -v error -f image2pipe -vcodec png -i pipe:0 -f bmp pipe:1
  else
    return 1
  fi | tail -c +15
}

if [ "${1:-}" = --convert ]; then
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  if png_to_dib >"$tmp" && [ -s "$tmp" ]; then
    xclip -selection clipboard -t DIB -i "$tmp"
  fi
  exit 0
fi

have wl-paste && have xclip || exit 0
[ -n "${WAYLAND_DISPLAY:-}" ] || exit 0
have magick || have convert || have ffmpeg || exit 0

exec wl-paste --watch --type image/png "$0" --convert
