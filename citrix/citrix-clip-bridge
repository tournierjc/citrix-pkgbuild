#!/usr/bin/python3
"""Offer Wayland image/png captures to X11 as CF_DIB for Citrix wfica.

wfica only imports a short X11 target list (DIB, _ISL_DIB, PIXMAP, text).
KDE copies screenshots as Wayland image/png; XWayland re-offers MIME types,
which Citrix logs as "No interesting targets".

GTK sends large DIB via INCR because XMaxRequestSize is ~256KB. wfica
reassembles those chunks incorrectly (image split). This daemon serves DIB
with XChangeProperty on a BIG-REQUESTS connection (~16MB) so the bitmap
goes in one reply. 32bpp BI_RGB avoids the 24bpp row-pad channel swap.

Citrix's _ISL_DIB importer always memcpy's pixels from offset 0x428
(BITMAPINFOHEADER + a 1024-byte RGBQUAD slot), not from offset 40.
"""
from __future__ import annotations

import ctypes
import fcntl
import hashlib
import os
import signal
import stat
import struct
import subprocess
import sys
import syslog

