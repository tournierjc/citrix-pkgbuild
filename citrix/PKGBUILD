pkgname=icaclient-bin
pkgver=26.04.10.1
pkgrel=19
pkgdesc="Citrix ICA Client (repackaged vendor RPM, no compilation)"
arch=('x86_64')
url="https://www.citrix.com/downloads/workspace-app/linux/workspace-app-for-linux-latest.html"
license=('custom:Citrix')
depends=(
  bash bubblewrap python-gobject wl-clipboard xorg-xprop
  libxss libxrandr libxcursor libxcomposite libxdamage libxfixes libxinerama libxtst
  alsa-lib libx11 libxcb nss gtk3 libsoup webkit2gtk-4.1
  libva libva-nvidia-driver
)
makedepends=(rpm-tools cpio)
optdepends=(
  'lshw: hardware probing some Citrix diagnostics may attempt to use'
)
provides=('icaclient')
conflicts=('icaclient')

# Citrix puts the time-limited download token on rel=, not href=. Since 2604
# the RHEL RPM is named ICAClient-rhel-gcc-8-${pkgver}-0.x86_64.rpm.
_citrix_dl_page="$url"
_rpm_file="ICAClient-rhel-gcc-8-${pkgver}-0.x86_64.rpm"
_html="$(curl -fsSL "$_citrix_dl_page" 2>/dev/null || true)"
_dl_rel="$(printf '%s\n' "$_html" \
  | grep -oP '(?<=rel=")[^"]*ICAClient-rhel-gcc-8-'"${pkgver}"'[^"]*\.rpm(\?[^"]*)?' \
  | head -n1 || true)"
if [[ -z "$_dl_rel" ]]; then
  _rpm_file="ICAClient-rhel-${pkgver}-0.x86_64.rpm"
  _dl_rel="$(printf '%s\n' "$_html" \
    | grep -oP '(?<=rel=")[^"]*ICAClient-rhel-'"${pkgver}"'[^"]*\.rpm(\?[^"]*)?' \
    | head -n1 || true)"
fi

if [[ -n "$_dl_rel" ]]; then
  source=("${_rpm_file}::https:${_dl_rel}" "citrix-clip-bridge" "citrix-clip-bridge.service" "wfica")
else
  source=("${_rpm_file}" "citrix-clip-bridge" "citrix-clip-bridge.service" "wfica")
fi
noextract=("${_rpm_file}")
sha256sums=('c29820638ef5924233dd7546058e0ff662aae5c2a2e280c8eb900246908d9f25' 'SKIP' 'SKIP' 'SKIP')
install=icaclient-bin.install
options=(!strip)

build() {
  cd "$srcdir"
  rm -rf opt usr etc
  local rpm
  if [[ -f "ICAClient-rhel-gcc-8-${pkgver}-0.x86_64.rpm" ]]; then
    rpm="ICAClient-rhel-gcc-8-${pkgver}-0.x86_64.rpm"
  elif [[ -f "ICAClient-rhel-${pkgver}-0.x86_64.rpm" ]]; then
    rpm="ICAClient-rhel-${pkgver}-0.x86_64.rpm"
  else
    set -- *.rpm
    [[ -f "$1" ]] || { echo "No RPM found to extract"; return 1; }
    rpm="$1"
  fi
  rpm2cpio "$rpm" | cpio -idmv
}

package() {
  cd "$srcdir"

  for d in opt usr etc; do
    [[ -d "$d" ]] && cp -a "$d" "$pkgdir/"
  done

  local root="$pkgdir/opt/Citrix/ICAClient"
  [[ -d "$root" ]] || { echo "Missing $root after RPM extraction"; return 1; }

  install -d "$root/config"

  # Normalize the bundled WebKit payload into a usable private libdir.
  # The vendor tarball expands to webkit2gtk-4.0-package/usr/lib/x86_64-linux-gnu/*,
  # which is not searched by our wrapper. Copy the relevant libs and helpers into
  # /opt/Citrix/ICAClient/Webkit2gtk4.0/lib.
  local wktar="$root/Webkit2gtk4.0/webkit2gtk-4.0.tar.gz"
  if [[ -f "$wktar" ]]; then
    local wkstage="$srcdir/webkit2gtk-stage"
    rm -rf "$wkstage"
    mkdir -p "$wkstage"
    tar -xzf "$wktar" -C "$wkstage"

    local wkdeb="$wkstage/webkit2gtk-4.0-package/usr/lib/x86_64-linux-gnu"
    if [[ -d "$wkdeb" ]]; then
      install -d "$root/Webkit2gtk4.0/lib"
      cp -a "$wkdeb"/lib*.so* "$root/Webkit2gtk4.0/lib/" 2>/dev/null || true
      if [[ -d "$wkdeb/webkit2gtk-4.0" ]]; then
        cp -a "$wkdeb/webkit2gtk-4.0" "$root/Webkit2gtk4.0/lib/"
      fi
    fi
  fi

  # Remove embedded Debian package tree so it does not conflict with prior manual extractions.
  rm -rf "$root/Webkit2gtk4.0/webkit2gtk-4.0-package"

  # Minimal config files required by the runtime.
  # Force a French default profile at package level.
  if [[ -f "$root/nls/fr/wfclient.template" ]]; then
    cp "$root/nls/fr/wfclient.template" "$root/config/wfclient.ini"
  elif [[ ! -f "$root/config/wfclient.ini" ]]; then
    cat > "$root/config/wfclient.ini" <<'EOF'
[WFClient]
Version=2
KeyboardLayout = French
KeyboardType=(Default)
KeyboardMappingFile = automatic.kbd
KeyboardDescription = French
KeyboardEventMode = Scancode
KeyboardSyncMode = Once
UseEUKS=2
UseEUKSforASCII=True
KeyboardSendLocale=True
MouseSendsControlV=False
ClientAudio=On
AllowLocalDrives=True
DisablePrinterRedirection=False
EOF
  fi

  # Nested RDP (MSTSC inside a Windows VDA) needs scancodes for Ctrl+C/V.
  # Sync French once at launch so the VDA layout matches AZERTY scancodes.
  # UseEUKSforASCII sends character keys as Unicode so MSTSC/Winlogon (often
  # US QWERTY until the user profile loads) still receives AZERTY letters.
  # MouseSendsControlV=True (vendor default) remaps middle-click to Ctrl+V.
  if [[ -f "$root/config/wfclient.ini" ]]; then
    sed -i \
      -e 's/^KeyboardLayout *=.*/KeyboardLayout = French/' \
      -e 's/^KeyboardType *=.*/KeyboardType=(Default)/' \
      -e 's/^KeyboardMappingFile *=.*/KeyboardMappingFile = automatic.kbd/' \
      -e 's/^KeyboardDescription *=.*/KeyboardDescription = French/' \
      -e 's/^KeyboardEventMode *=.*/KeyboardEventMode = Scancode/' \
      -e 's/^KeyboardSyncMode *=.*/KeyboardSyncMode = Once/' \
      -e 's/^UseEUKS *=.*/UseEUKS=2/' \
      -e 's/^UseEUKSforASCII *=.*/UseEUKSforASCII=True/' \
      -e 's/^KeyboardSendLocale *=.*/KeyboardSendLocale=True/' \
      -e 's/^MouseSendsControlV *=.*/MouseSendsControlV=False/' \
      "$root/config/wfclient.ini"
    grep -q '^UseEUKS *=' "$root/config/wfclient.ini" || \
      sed -i '/^\[WFClient\]/a UseEUKS=2' "$root/config/wfclient.ini"
    grep -q '^UseEUKSforASCII *=' "$root/config/wfclient.ini" || \
      sed -i '/^\[WFClient\]/a UseEUKSforASCII=True' "$root/config/wfclient.ini"
    grep -q '^KeyboardSendLocale *=' "$root/config/wfclient.ini" || \
      sed -i '/^\[WFClient\]/a KeyboardSendLocale=True' "$root/config/wfclient.ini"
    grep -q '^MouseSendsControlV *=' "$root/config/wfclient.ini" || \
      sed -i '/^\[WFClient\]/a MouseSendsControlV=False' "$root/config/wfclient.ini"
  fi

  # Insert or replace a key in an existing INI section. Use Python so headers
  # that contain backslashes (e.g. [Virtual Channels\Thinwire Graphics]) are
  # not treated as regex; grep/sed previously appended duplicate empty sections
  # and Citrix then rejected the ICA file as damaged.
  _ini_set() {
    local file=$1 section=$2 key=$3 value=$4
    [[ -f "$file" ]] || return 0
    python3 - "$file" "$section" "$key" "$value" <<'PY'
import sys
from pathlib import Path

path, section, key, value = sys.argv[1:5]
header = f"[{section}]"
raw = Path(path).read_text()
newline = "\r\n" if "\r\n" in raw else "\n"
lines = raw.splitlines()
idx = next((i for i, line in enumerate(lines) if line.strip() == header), None)
if idx is None:
    if lines and lines[-1].strip():
        lines.append("")
    lines.append(header)
    idx = len(lines) - 1
end = idx + 1
while end < len(lines):
    stripped = lines[end].strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        break
    end += 1
found = False
for i in range(idx + 1, end):
    line = lines[i]
    if not line or line.lstrip().startswith(";") or "=" not in line:
        continue
    if line.split("=", 1)[0].strip() == key:
        lines[i] = f"{key}={value}"
        found = True
        break
if not found:
    lines.insert(idx + 1, f"{key}={value}")
Path(path).write_text(newline.join(lines) + newline)
PY
  }

  # Enable GPU decode. Do not lock DesiredHRES/VRES: that pinned every session
  # to 3840x2160 and blocked windowed / smaller sizes.
  local ini
  for ini in "$root/config/wfclient.ini"; do
    _ini_set "$ini" Thinwire3.0 OpenGLEnabled True
    _ini_set "$ini" Thinwire3.0 HWAccelerationEnabled True
    _ini_set "$ini" Thinwire3.0 H264Enabled True
    _ini_set "$ini" Thinwire3.0 H265Enabled True
    _ini_set "$ini" Thinwire3.0 DirectDecode True
  done
  for ini in "$root/config/All_Regions.ini" "$root/config/All_Regions_desktoplock.ini"; do
    _ini_set "$ini" 'Virtual Channels\Thinwire Graphics' HWAccelerationEnabled True
    # Empty KeyboardLayout= is unrestricted, so a StoreFront ICA can force US
    # QWERTY onto nested MSTSC / Winlogon. Pin the AZERTY scancode + EUKS path.
    _ini_set "$ini" 'Virtual Channels\Keyboard' KeyboardLayout French
    _ini_set "$ini" 'Virtual Channels\Keyboard' KeyboardEventMode Scancode
    _ini_set "$ini" 'Virtual Channels\Keyboard' KeyboardSyncMode Once
    _ini_set "$ini" 'Virtual Channels\Keyboard' KeyboardMappingFile automatic.kbd
    _ini_set "$ini" 'Virtual Channels\Keyboard' KeyboardSendLocale True
    _ini_set "$ini" 'Virtual Channels\Keyboard' UseEUKS 2
    _ini_set "$ini" 'Virtual Channels\Keyboard' UseEUKSforASCII True
    _ini_set "$ini" 'Virtual Channels\Keyboard' ScancodeEnabled True
  done

  # Force the same keyboard defaults in appsrv.ini as well; some Citrix flows
  # still consult [WFClient] there.
  if [[ -f "$root/config/appsrv.ini" ]]; then
    if ! grep -q '^\[WFClient\]' "$root/config/appsrv.ini"; then
      printf '\n[WFClient]\n' >> "$root/config/appsrv.ini"
    fi
    if grep -q '^KeyboardLayout *=.*' "$root/config/appsrv.ini"; then
      sed -i 's/^KeyboardLayout *=.*/KeyboardLayout=French/' "$root/config/appsrv.ini"
    else
      sed -i '/^\[WFClient\]/a KeyboardLayout=French' "$root/config/appsrv.ini"
    fi
  else
    cat > "$root/config/appsrv.ini" <<'EOF'
[WFClient]
KeyboardLayout=French
EOF
  fi

  if [[ ! -f "$root/config/module.ini" ]]; then
    if [[ -f "$root/nls/fr/module.ini" ]]; then
      cp "$root/nls/fr/module.ini" "$root/config/module.ini"
    elif [[ -f "$root/nls/en/module.ini" ]]; then
      cp "$root/nls/en/module.ini" "$root/config/module.ini"
    elif [[ -f "$root/nls/en_US/module.ini" ]]; then
      cp "$root/nls/en_US/module.ini" "$root/config/module.ini"
    fi
  fi

  # Some client startup paths validate ICAROOT by checking for top-level support
  # files such as eula.txt. The RPM only ships localized copies under nls/*.
  if [[ ! -f "$root/eula.txt" ]]; then
    if [[ -f "$root/nls/en.UTF-8/eula.txt" ]]; then
      ln -sf nls/en.UTF-8/eula.txt "$root/eula.txt"
    elif [[ -f "$root/nls/en/eula.txt" ]]; then
      ln -sf nls/en/eula.txt "$root/eula.txt"
    fi
  fi

  # Default permissions first, then restore executables.
  find "$root" -type d -exec chmod 755 {} +
  find "$root" -type f -exec chmod 644 {} +

  local execs=(
    wfica wfcrun32 icasessionmgr ctxfuse selfservice PrimaryAuthManager
    AuthManagerDaemon UtilDaemon NativeMessagingHost
  )
  for b in "${execs[@]}"; do
    [[ -f "$root/$b" ]] && chmod 755 "$root/$b"
  done
  find "$root" \( -name '*.so' -o -name '*.so.*' \) -type f -exec chmod 755 {} +
  [[ -d "$root/Webkit2gtk4.0/lib" ]] && find "$root/Webkit2gtk4.0/lib" -type f -exec chmod 755 {} +
  [[ -d "$root/util" ]] && find "$root/util" -type f -exec chmod 755 {} +

  install -Dm755 "$srcdir/citrix-clip-bridge" "$root/util/citrix-clip-bridge"
  install -Dm644 "$srcdir/citrix-clip-bridge.service" \
    "$pkgdir/usr/lib/systemd/user/citrix-clip-bridge.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../citrix-clip-bridge.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/citrix-clip-bridge.service"

  install -d "$pkgdir/usr/bin"

  # Selfservice and .ica mime launches both exec $ICAROOT/wfica. Keep the
  # vendor binary as wfica.real and install our wrapper under the original name.
  mv "$root/wfica" "$root/wfica.real"
  chmod 755 "$root/wfica.real"
  install -Dm755 "$srcdir/wfica" "$root/wfica"

  # Upstream wfica disables VAAPI whenever NVML reports an NVIDIA GPU
  # ("Hardware decoding disabled because Nvidia GPU is installed"), then
  # falls back to CPU H.264. Patch IsNvidiaGpuInstalled to return false so
  # libctxVideoDecoder.so can use h264_vaapi via libva-nvidia-driver/NVDEC.
  python3 - "$root/wfica.real" <<'PY'
import pathlib, subprocess, sys

path = pathlib.Path(sys.argv[1])
nm = subprocess.check_output(["nm", "-D", str(path)], text=True)
addr = None
for line in nm.splitlines():
    parts = line.split()
    if len(parts) >= 3 and parts[-1] == "IsNvidiaGpuInstalled" and parts[1] == "T":
        addr = int(parts[0], 16)
        break
if addr is None:
    sys.exit("IsNvidiaGpuInstalled not found in wfica.real")
data = bytearray(path.read_bytes())
# ELF LOAD is mapped 1:1 from file offset 0 for this PIE binary.
if data[addr : addr + 2] != bytes((0x41, 0x54)):  # push %r12
    sys.exit(f"unexpected prologue at {addr:#x}: {data[addr:addr+8].hex()}")
data[addr : addr + 3] = bytes((0x31, 0xC0, 0xC3))  # xor %eax,%eax; ret
path.write_bytes(data)
print(f"patched IsNvidiaGpuInstalled at {addr:#x}")
PY

  cat > "$pkgdir/usr/bin/wfica" <<'EOF'
#!/bin/sh
exec /opt/Citrix/ICAClient/wfica "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/wfica"

  if [[ -f "$root/wfcrun32" ]]; then
    cat > "$pkgdir/usr/bin/wfcrun32" <<'EOF'
#!/bin/sh
ICAROOT=/opt/Citrix/ICAClient
export ICAROOT
export LD_LIBRARY_PATH="${ICAROOT}/lib:${ICAROOT}/Webkit2gtk4.0/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export GTK_PATH="${ICAROOT}/gtk${GTK_PATH:+:${GTK_PATH}}"
exec "$ICAROOT/wfcrun32" -icaroot "$ICAROOT" "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/wfcrun32"
  fi

  install -d "$pkgdir/etc/profile.d"
  cat > "$pkgdir/etc/profile.d/icaclient.sh" <<'EOF'
export ICAROOT=/opt/Citrix/ICAClient
export LD_LIBRARY_PATH=/opt/Citrix/ICAClient/lib:/opt/Citrix/ICAClient/Webkit2gtk4.0/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export GTK_PATH=/opt/Citrix/ICAClient/gtk${GTK_PATH:+:$GTK_PATH}
EOF

  install -d "$pkgdir/etc/ld.so.conf.d"
  cat > "$pkgdir/etc/ld.so.conf.d/icaclient.conf" <<'EOF'
/opt/Citrix/ICAClient/lib
/opt/Citrix/ICAClient/Webkit2gtk4.0/lib
EOF

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/citrix-ica.desktop" <<'EOF'
[Desktop Entry]
Name=Citrix ICA Client
Exec=/usr/bin/wfica %f
Type=Application
MimeType=application/x-ica;
Categories=Network;
EOF

  # Absolute-path compatibility shims expected by the proprietary binary.
  ln -sf /opt/Citrix/ICAClient "$pkgdir/ICAROOT"
  ln -sf /opt/Citrix/ICAClient/config "$pkgdir/config"
  ln -sf /opt/Citrix/ICAClient/gtk "$pkgdir/gtk"
  ln -sf /opt/Citrix/ICAClient/keyboard "$pkgdir/keyboard"
  ln -sf /opt/Citrix/ICAClient/keyboard "$pkgdir/keyboad"
  [[ -f "$root/CHARICONV.DLL" ]] && ln -sf /opt/Citrix/ICAClient/CHARICONV.DLL "$pkgdir/CHARICONV.DLL"

  install -d "$pkgdir/usr/lib"
  [[ -f "$root/lib/UIDialogLib3.so" ]] && \
    ln -sf /opt/Citrix/ICAClient/lib/UIDialogLib3.so "$pkgdir/usr/lib/UIDialogLib3.so"
  [[ -f "$root/lib/UIDialogLibWebKit3.so" ]] && \
    ln -sf /opt/Citrix/ICAClient/lib/UIDialogLibWebKit3.so "$pkgdir/usr/lib/UIDialogLibWebKit3.so"
}
